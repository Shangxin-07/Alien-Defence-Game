{
  "name": "alien-defence-game",
  "private": true,
  "version": "0.1.0",
  "description": "A brutal, turn-based alien defence game in the vein of UFO: Enemy Unknown.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
